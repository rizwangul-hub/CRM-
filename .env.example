# MongoDB Atlas Connection String (leave blank to use persistent local MongoDB in development)
MONGODB_URI=""

# JWT Authentication Secret (use a long random string in production)
JWT_SECRET="change-me-to-a-strong-random-64-char-secret-in-production"
JWT_EXPIRES_IN="7d"

# Application Environment
NODE_ENV="development"
APP_PORT="3000"

# Allowed CORS origin (comma-separated if multiple)
CORS_ORIGIN=""

# APP_URL: Automatically injected at runtime with the hosted service URL
APP_URL="http://localhost:3000"
